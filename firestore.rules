rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "prakashkommarajula@gmail.com" && request.auth.token.email_verified == true));
    }
    function isDocOwner(docData) {
      return isAuthenticated() && request.auth.uid == docData.ownerId;
    }
    function isFarmer(docData) {
      return isAuthenticated() && request.auth.uid == docData.farmerId;
    }

    // ===============================================================
    // User Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role in ['farmer', 'owner', 'admin'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Equipment Rules
    // ===============================================================
    match /equipment/{equipmentId} {
      allow read: if true; // Publicly viewable
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // ===============================================================
    // Booking Rules
    // ===============================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.farmerId || request.auth.uid == resource.data.ownerId || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.farmerId || request.auth.uid == resource.data.ownerId || isAdmin());
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Chat Rules
    // ===============================================================
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (chatId.contains(request.auth.uid) || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (chatId.contains(request.auth.uid) || isAdmin());
      }
    }
  }
}
